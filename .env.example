# ---------------------------------------------------------
# Rafeequl Hifz — environment configuration template
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored. NEVER commit real secrets.
# ---------------------------------------------------------

# Application
APP_NAME="Rafeequl Hifz"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_KEY=

# Session
SESSION_NAME=rafeequl_hifz_session
SESSION_LIFETIME=120

# Authentication policy
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=60

# Rate limiting for register / forgot-password / reset-password
# (per fixed window; disabled automatically when APP_ENV=testing)
RATE_LIMIT_IP_MAX=10
RATE_LIMIT_EMAIL_MAX=5
RATE_LIMIT_WINDOW_SECONDS=60

# Database (MySQL) — leave empty until configured; never hard-code production credentials
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Hosting example (InfinityFree — full process in docs/deployment/infinityfree.md):
#   DB_HOST=sql303.infinityfree.com   <- exact host shown in the panel (external
#                                        connections are blocked; localhost is wrong)
#   DB_DATABASE / DB_USERNAME / DB_PASSWORD <- values from the panel's MySQL page
#   APP_URL=https://yourdomain.example <- https:// required for the PWA
#   APP_DEBUG=false, APP_ENV=production in production

# Logging
LOG_CHANNEL=storage
LOG_LEVEL=info
