# Configuration (database credentials come from .env, not from here) -
# never web-reachable. Inner layer of the htdocs-only deployment layout;
# inert in the split layout where this directory sits above the document
# root. See docs/deployment/infinityfree.md.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
